{
  "expo": {
    "name": "ZPIN",
    "slug": "zpin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon_1024.png",
    "scheme": "zpinecom",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e71bc344-7fa9-4436-aaeb-8aaf1ac044ec",
      "enabled": false,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zpin.ecom",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_icon_1024.png",
        "backgroundColor": "#FFC800"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.zpin.ecom",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.19891056241-ggdjrjllnt4qn6an7ldukcmabt2htegm"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ZPIN uses your location only while you're using the app to show product availability and delivery options near you.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app_icon_1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/HankenGrotesk_400Regular.ttf",
            "./assets/fonts/HankenGrotesk_500Medium.ttf",
            "./assets/fonts/HankenGrotesk_600SemiBold.ttf",
            "./assets/fonts/HankenGrotesk_700Bold.ttf",
            "./assets/fonts/HankenGrotesk_800ExtraBold.ttf",
            "./assets/fonts/SpaceGrotesk_400Regular.ttf",
            "./assets/fonts/SpaceGrotesk_500Medium.ttf",
            "./assets/fonts/SpaceGrotesk_600SemiBold.ttf",
            "./assets/fonts/SpaceGrotesk_700Bold.ttf",
            "./assets/fonts/SpaceMono_400Regular.ttf",
            "./assets/fonts/SpaceMono_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e71bc344-7fa9-4436-aaeb-8aaf1ac044ec"
      }
    }
  }
}
